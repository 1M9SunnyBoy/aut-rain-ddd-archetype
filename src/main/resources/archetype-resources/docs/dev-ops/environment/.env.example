#set( $dollar = '$' )
#set( $hash = '#' )
${hash} description: 提供开发中间件端口和默认凭据的覆盖示例。
${hash} author: zzy
${hash} created: 2026-10-19
${hash} Optional local development overrides. docker-compose.dev.yml works without this file.
${hash} For production, configure app/.env using app/.env.example.
${hash} Fixed mappings: Nacos API 18848, gRPC 19848/19849; RocketMQ NameServer 19876, Broker 20909/20911/20912.
MYSQL_PORT=13306
REDIS_PORT=16379
NACOS_CONSOLE_PORT=18080
XXL_JOB_PORT=19090
PHPMYADMIN_PORT=18899
REDIS_ADMIN_PORT=18081
ROCKETMQ_DASHBOARD_PORT=18082
MYSQL_ROOT_PASSWORD=123456
MYSQL_PASSWORD=123456
${hash} Redis server has no password. This is the Redis Commander web login password.
REDIS_ADMIN_PASSWORD=admin
${hash} Fixed development signing token; not a console login password.
NACOS_AUTH_TOKEN=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWYwMTIzNDU2Nzg5YWJjZGVm
NACOS_AUTH_IDENTITY_VALUE=dev-server-identity
XXL_JOB_ACCESS_TOKEN=default_token
${hash} XXL-Job initial admin / 123456 comes from mysql/sql/xxl-job.sql; change it in the console.

${hash} RustFS S3 storage and console credentials.
RUSTFS_API_PORT=19000
RUSTFS_CONSOLE_PORT=19001
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
