#set( $dollar = '$' )
#set( $hash = '#' )
${hash} Copy to app/.env; replace all CHANGE_ME values before starting middleware.
${hash} Password alphabet A-Z a-z 0-9 _ -, length 24-128. Use different random values.
HTTP_BIND=0.0.0.0
HTTP_PORT=${httpPort}
MYSQL_PASSWORD=CHANGE_ME_APP_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_DATABASE_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
${hash} Standard Base64 encoding of at least 32 random bytes, not the console password.
NACOS_AUTH_TOKEN=CHANGE_ME_BASE64_TOKEN
NACOS_AUTH_IDENTITY_VALUE=CHANGE_ME_NACOS_IDENTITY_VALUE
XXL_JOB_ACCESS_TOKEN=CHANGE_ME_XXL_ACCESS_TOKEN
${hash} XXL-Job initial admin / 123456 comes from mysql/sql/xxl-job.sql; change it in the console.

${hash} RustFS S3 storage and console credentials.
RUSTFS_ACCESS_KEY=CHANGE_ME_RUSTFS_ACCESS_KEY
RUSTFS_SECRET_KEY=CHANGE_ME_RUSTFS_SECRET_KEY
